{
  "openapi": "3.1.0",
  "info": {
    "title": "LoL Live Widget",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/matches": {
      "get": {
        "summary": "Matches",
        "operationId": "matches_api_v1_matches_get",
        "parameters": [
          {
            "name": "league",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "worlds",
              "title": "League"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatchSummary"
                  },
                  "title": "Response Matches Api V1 Matches Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/matches/{match_id}/state": {
      "get": {
        "summary": "State",
        "operationId": "state_api_v1_matches__match_id__state_get",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Match Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/matches/{match_id}/sync": {
      "get": {
        "summary": "Sync",
        "operationId": "sync_api_v1_matches__match_id__sync_get",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Match Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/matches/{match_id}/events": {
      "get": {
        "summary": "Events",
        "operationId": "events_api_v1_matches__match_id__events_get",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Match Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/matches/{match_id}/stream": {
      "get": {
        "summary": "Stream",
        "operationId": "stream_api_v1_matches__match_id__stream_get",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Match Id"
            }
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventsPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MatchEvent"
            },
            "type": "array",
            "title": "Items"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "EventsPage"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchEvent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "matchId": {
            "type": "string",
            "title": "Matchid"
          },
          "gameId": {
            "type": "string",
            "title": "Gameid"
          },
          "type": {
            "type": "string",
            "enum": [
              "KILL_DELTA",
              "MULTIKILL_WINDOW",
              "DRAGON",
              "BARON",
              "ELDER",
              "DRAGON_SOUL",
              "TOWER",
              "GOLD_LEAD_CHANGE",
              "GAME_END"
            ],
            "title": "Type"
          },
          "gameTimeSeconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gametimeseconds"
          },
          "occurredAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurredat"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Observedat"
          },
          "teamId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Teamid"
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "important",
              "critical"
            ],
            "title": "Priority"
          },
          "messageKo": {
            "type": "string",
            "title": "Messageko"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "confirmed",
              "derived"
            ],
            "title": "Confidence"
          },
          "sourceRevision": {
            "type": "integer",
            "title": "Sourcerevision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "matchId",
          "gameId",
          "type",
          "gameTimeSeconds",
          "occurredAt",
          "observedAt",
          "teamId",
          "priority",
          "messageKo",
          "confidence",
          "sourceRevision"
        ],
        "title": "MatchEvent"
      },
      "MatchState": {
        "properties": {
          "matchId": {
            "type": "string",
            "title": "Matchid"
          },
          "gameId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gameid"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "live",
              "ended",
              "unknown"
            ],
            "title": "Status"
          },
          "connection": {
            "type": "string",
            "enum": [
              "live",
              "delayed",
              "offline"
            ],
            "title": "Connection"
          },
          "league": {
            "type": "string",
            "title": "League"
          },
          "blue": {
            "$ref": "#/components/schemas/TeamState"
          },
          "red": {
            "$ref": "#/components/schemas/TeamState"
          },
          "gameNumber": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gamenumber"
          },
          "gameTimeSeconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gametimeseconds"
          },
          "sourceTimestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourcetimestamp"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Receivedat"
          },
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "sourceError": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceerror"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "matchId",
          "gameId",
          "status",
          "connection",
          "league",
          "blue",
          "red",
          "gameNumber",
          "gameTimeSeconds",
          "sourceTimestamp",
          "receivedAt",
          "revision"
        ],
        "title": "MatchState"
      },
      "MatchSummary": {
        "properties": {
          "matchId": {
            "type": "string",
            "title": "Matchid"
          },
          "league": {
            "type": "string",
            "title": "League",
            "default": "worlds"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "live",
              "ended",
              "unknown"
            ],
            "title": "Status",
            "default": "live"
          },
          "blue": {
            "$ref": "#/components/schemas/TeamState"
          },
          "red": {
            "$ref": "#/components/schemas/TeamState"
          },
          "gameId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gameid"
          },
          "gameNumber": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gamenumber"
          },
          "scheduledAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduledat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "matchId",
          "blue",
          "red"
        ],
        "title": "MatchSummary"
      },
      "SyncSnapshot": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/MatchState"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/MatchEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "streamCursor": {
            "type": "string",
            "title": "Streamcursor"
          },
          "sourceMode": {
            "type": "string",
            "enum": [
              "live",
              "replay"
            ],
            "title": "Sourcemode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "events",
          "streamCursor",
          "sourceMode"
        ],
        "title": "SyncSnapshot"
      },
      "TeamState": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "shortName": {
            "type": "string",
            "title": "Shortname"
          },
          "seriesWins": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Serieswins",
            "default": 0
          },
          "kills": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Kills"
          },
          "gold": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Gold"
          },
          "towers": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 11.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Towers"
          },
          "dragons": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Dragons"
          },
          "barons": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Barons"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "shortName"
        ],
        "title": "TeamState"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
